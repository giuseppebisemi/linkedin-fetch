# Apify API token — required.
# Get one at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Anthropic API key — optional.
# Required only if you invoke the script directly with --dates "<natural language>"
# (i.e. without the --from / --to flags). The linkedin-fetch skill never uses
# this path: the host agent parses dates itself and passes --from / --to.
ANTHROPIC_API_KEY=
